
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">

    <title>Reset Your Password</title>

    <style>
        body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            background-color: #f4f6f9;
            font-family: Arial, Helvetica, sans-serif;
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }

        table {
            border-spacing: 0;
            border-collapse: collapse;
        }

        a {
            text-decoration: none;
        }

        @media only screen and (max-width: 600px) {
            .email-container {
                width: 100% !important;
            }

            .content {
                padding: 28px 22px !important;
            }

            .header {
                padding: 28px 20px !important;
            }

            .footer {
                padding: 22px 15px !important;
            }

            .reset-button {
                display: block !important;
                text-align: center !important;
            }

            .otp-code {
                font-size: 30px !important;
                letter-spacing: 8px !important;
            }
        }
    </style>
</head>

<body style="margin:0; padding:0; background-color:#f4f6f9;">

    <!-- Preheader -->
    <div style="
        display:none;
        font-size:1px;
        color:#f4f6f9;
        line-height:1px;
        max-height:0;
        max-width:0;
        opacity:0;
        overflow:hidden;
    ">
        {{#if isMobile}}
            Your {{appName}} password reset code is {{otp}}.
        {{else}}
            Follow the instructions to reset your {{appName}} password.
        {{/if}}
    </div>

    <table
        role="presentation"
        width="100%"
        cellpadding="0"
        cellspacing="0"
        border="0"
        bgcolor="#f4f6f9"
    >
        <tr>
            <td align="center" style="padding:35px 15px;">

                <!-- Main container -->
                <table
                    role="presentation"
                    class="email-container"
                    width="600"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    bgcolor="#ffffff"
                    style="
                        width:100%;
                        max-width:600px;
                        background:#ffffff;
                        border-radius:10px;
                        overflow:hidden;
                    "
                >

                    <!-- Header -->
                    <tr>
                        <td
                            class="header"
                            align="center"
                            bgcolor="#0f172a"
                            style="padding:35px 30px; color:#ffffff;"
                        >
                            <h1 style="
                                margin:0;
                                font-size:26px;
                                line-height:1.3;
                                font-weight:bold;
                                color:#ffffff;
                            ">
                                {{appName}}
                            </h1>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td
                            class="content"
                            style="
                                padding:40px;
                                color:#374151;
                                font-size:15px;
                                line-height:1.7;
                            "
                        >

                            <h2 style="
                                margin:0 0 20px;
                                color:#111827;
                                font-size:22px;
                            ">
                                Hello {{name}},
                            </h2>

                            <p style="margin:0 0 18px;">
                                We received a request to reset the password
                                associated with your {{appName}} account.
                            </p>

                            {{#if isMobile}}

                                <!-- MOBILE OTP PASSWORD RESET -->

                                <p style="margin:0 0 20px;">
                                    Enter the verification code below in your
                                    {{appName}} mobile application to continue
                                    resetting your password.
                                </p>

                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    bgcolor="#f9fafb"
                                    style="
                                        background:#f9fafb;
                                        border-radius:8px;
                                        margin:25px 0;
                                    "
                                >
                                    <tr>
                                        <td
                                            align="center"
                                            style="padding:25px 15px;"
                                        >
                                            <p style="
                                                margin:0 0 12px;
                                                font-size:12px;
                                                font-weight:bold;
                                                color:#6b7280;
                                                text-transform:uppercase;
                                                letter-spacing:1px;
                                            ">
                                                Your password reset code
                                            </p>

                                            <h1
                                                class="otp-code"
                                                style="
                                                    margin:0;
                                                    font-size:34px;
                                                    line-height:1.4;
                                                    font-weight:bold;
                                                    letter-spacing:10px;
                                                    color:#0f172a;
                                                "
                                            >
                                                {{otp}}
                                            </h1>

                                            <p style="
                                                margin:12px 0 0;
                                                font-size:13px;
                                                color:#6b7280;
                                            ">
                                                Expires in
                                                <strong>{{expiryMinutes}} minutes</strong>
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <p style="
                                    margin:20px 0;
                                    font-size:14px;
                                    color:#4b5563;
                                ">
                                    Return to your {{appName}} mobile app
                                    and enter this code to continue.
                                    You will then be able to create a new password.
                                </p>

                                <p style="
                                    margin:20px 0;
                                    font-size:13px;
                                    color:#6b7280;
                                ">
                                    Never share this code with anyone,
                                    including anyone claiming to represent
                                    {{appName}}.
                                </p>

                            {{else}}

                                <!-- WEB PASSWORD RESET -->

                                <p style="margin:0 0 20px;">
                                    Click the button below to securely
                                    reset your password.
                                </p>

                                <!-- Reset password button -->
                                <table
                                    role="presentation"
                                    align="center"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="margin:30px auto;"
                                >
                                    <tr>
                                        <td
                                            align="center"
                                            bgcolor="#2563eb"
                                            style="border-radius:8px;"
                                        >
                                            <a
                                                href="{{resetPasswordUrl}}"
                                                class="reset-button"
                                                target="_blank"
                                                style="
                                                    display:inline-block;
                                                    padding:15px 32px;
                                                    font-size:16px;
                                                    font-weight:bold;
                                                    line-height:24px;
                                                    color:#ffffff;
                                                    background:#2563eb;
                                                    border-radius:8px;
                                                    text-decoration:none;
                                                "
                                            >
                                                Reset Password
                                            </a>
                                        </td>
                                    </tr>
                                </table>

                                <p style="margin:0 0 20px;">
                                    This password reset link will expire in
                                    <strong>{{expiryMinutes}} minutes</strong>.
                                </p>

                                <p style="margin:0 0 12px;">
                                    If the button doesn't work, copy and
                                    paste the following link into your browser:
                                </p>

                                <!-- Fallback URL -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    bgcolor="#f9fafb"
                                    style="
                                        background:#f9fafb;
                                        border-radius:6px;
                                    "
                                >
                                    <tr>
                                        <td style="
                                            padding:15px;
                                            font-size:13px;
                                            line-height:1.6;
                                            color:#6b7280;
                                            overflow-wrap:anywhere;
                                            word-break:break-all;
                                        ">
                                            <a
                                                href="{{resetPasswordUrl}}"
                                                target="_blank"
                                                style="
                                                    color:#2563eb;
                                                    text-decoration:underline;
                                                "
                                            >
                                                {{resetPasswordUrl}}
                                            </a>
                                        </td>
                                    </tr>
                                </table>

                            {{/if}}

                            <!-- Security notice -->
                            <table
                                role="presentation"
                                width="100%"
                                cellpadding="0"
                                cellspacing="0"
                                border="0"
                                bgcolor="#fff7ed"
                                style="
                                    margin-top:25px;
                                    background:#fff7ed;
                                    border-left:4px solid #f97316;
                                "
                            >
                                <tr>
                                    <td style="
                                        padding:15px;
                                        font-size:13px;
                                        line-height:1.6;
                                        color:#9a3412;
                                    ">
                                        If you didn't request a password
                                        reset, you can safely ignore this email.
                                        Your current password will remain unchanged.
                                    </td>
                                </tr>
                            </table>

                            <p style="
                                margin:30px 0 0;
                                font-size:14px;
                            ">
                                Need help? Contact us at
                                <a
                                    href="mailto:{{supportEmail}}"
                                    style="color:#2563eb;"
                                >
                                    {{supportEmail}}
                                </a>.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td
                            class="footer"
                            align="center"
                            bgcolor="#f8fafc"
                            style="
                                padding:25px;
                                background:#f8fafc;
                                color:#6b7280;
                                font-size:12px;
                                line-height:1.6;
                            "
                        >
                            © {{year}} {{appName}}.
                            All rights reserved.
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>
