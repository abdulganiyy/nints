{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets":[
      {
        "include":"../generated/prisma/**/*",
        "outDir":"dist/generated"

      },
      {
        "include": "email/templates/**/*",
        "outDir": "dist/src"
      }
    ],
    "deleteOutDir": true
  }
}
