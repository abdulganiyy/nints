generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  phone    String? @unique
  fullname String
  password String  @unique

  emailVerified          Boolean   @default(false)
  emailOtpHash           String?
  emailOtpExpiresAt      DateTime?
  otp                    String?
  otpExpiresAt           DateTime?
  resetPasswordToken     String?
  resetPasswordExpiresAt DateTime?

  pin String?

  status UserStatus @default(PENDING_VERIFICATION)

  phoneVerified Boolean @default(false)

  wallet Wallet?

  paystackCustomerId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   Boolean   @default(false)
  deletedAt DateTime?

  userRoles UserRole[]
  otps      Otp[]
}

model Wallet {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance  Decimal  @db.Decimal(18, 2)
  currency Currency @default(NGN)

  status WalletStatus @default(ACTIVE)

  virtualAccount VirtualAccount?

  account Account?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id String @id @default(cuid())

  code     String      @unique
  name     String
  type     AccountType
  currency String      @default("NGN")

  balance Decimal @default(0) @db.Decimal(19, 4)

  walletId String? @unique

  wallet Wallet? @relation(fields: [walletId], references: [id])

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([walletId])
}

enum AccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

model Transaction {
  id String @id @default(cuid())

  reference String @unique

  type   TransactionType
  status TransactionStatus

  amount   Decimal @db.Decimal(19, 4)
  currency String  @default("NGN")

  description String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model LedgerEntry {
  id String @id @default(cuid())

  transactionId String
  accountId     String

  amount    Decimal         @db.Decimal(19, 4)
  direction LedgerDirection

  balanceBefore Decimal? @db.Decimal(19, 4)
  balanceAfter  Decimal? @db.Decimal(19, 4)

  createdAt DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([transactionId])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  AIRTIME_PURCHASE
  DATA_PURCHASE
  BILL_PAYMENT
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  REFUND
  REVERSAL
  FEE
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL

  TRANSFER_IN
  TRANSFER_OUT

  AIRTIME_PURCHASE
  DATA_PURCHASE

  BILL_PAYMENT

  LOAN_DISBURSEMENT
  LOAN_REPAYMENT

  REFUND
  REVERSAL

  FEE
  ADJUSTMENT
}

model VirtualAccount {
  id String @id @default(cuid())

  walletId String @unique
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  provider VirtualAccountProvider

  bankName      String
  accountNumber String @unique
  accountName   String

  status VirtualAccountStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([provider])
  @@index([accountNumber])
}

model Role {
  id              String           @id @default(uuid())
  name            RoleName         @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum VirtualAccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  CLOSED
}

enum Currency {
  NGN
  USD
}

enum VirtualAccountProvider {
  PAYSTACK
  MONNIFY
  FLUTTERWAVE
  SAFE_HAVEN
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  LOGIN
}

model Otp {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  identifier String // email or phone
  codeHash   String

  purpose OtpPurpose

  expiresAt  DateTime
  verifiedAt DateTime?

  attempts Int @default(0)

  createdAt DateTime @default(now())

  @@index([identifier])
  @@index([purpose])
}
